# Copy to backend/.env. Run the API from backend/.
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Set true only when a configured local gateway is available.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=omniroute-local
OMNIROUTE_TIMEOUT=25
OMNIROUTE_MAX_RETRIES=0

# Fill in one provider you can access; model IDs depend on your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
GITHUB_TOKEN=
GITHUB_OPENAI_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODEL=

# Start without model-based graph extraction.
GRAPH_RAG_ENABLED=false
GRAPH_MAX_CHUNKS_PER_RUN=40
GRAPH_MAX_HOPS=1
GRAPH_MAX_CONTEXT_TRIPLES=20
